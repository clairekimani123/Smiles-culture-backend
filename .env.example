# ── Django core ─────────────────────────────────────────────
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend URL — used for CORS and links in emails
FRONTEND_URL=http://localhost:5173

# ── Email ───────────────────────────────────────────────────
# Dev: console (prints to terminal). Prod: Anymail + Resend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@smilesculture.co.ke
OWNER_EMAIL=owner@smilesculture.co.ke
RESEND_API_KEY=

# ── MPesa / Daraja ──────────────────────────────────────────
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox          # sandbox | production
MPESA_CALLBACK_URL=https://your-domain.ngrok.app/api/mpesa/callback

# ── Database ────────────────────────────────────────────────
# Dev: sqlite (leave blank). Prod: set DATABASE_URL
DATABASE_URL=

# ── Observability ───────────────────────────────────────────
SENTRY_DSN=